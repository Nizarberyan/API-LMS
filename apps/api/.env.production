# Production Environment
NODE_ENV=production

# Database - Use MongoDB Atlas or production cluster
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/lms_prod

# JWT Configuration - USE STRONG SECRETS!
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_STRONG_SECRET
JWT_REFRESH_EXPIRES_IN=7d

# SMTP (Production email service)
SMTP_HOST=smtp.production-service.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
SMTP_FROM=no-reply@yourdomain.com

# Server
PORT=3000
